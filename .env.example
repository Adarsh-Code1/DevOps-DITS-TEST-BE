# PostgreSQL
POSTGRES_USER=devops_store
POSTGRES_PASSWORD=example_password
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=devops_store
RABBITMQ_DEFAULT_PASS=example_password

# Redis
REDIS_PORT=6379

# JWT - dummy key only
JWT_SIGNING_KEY=replace_with_at_least_32_characters_dummy_key
JWT_ISSUER=devops-store-identity
JWT_AUDIENCE=devops-store-api

# Identity seed users - dummy passwords
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Store Admin
ADMIN_PASSWORD=replace_with_admin_password

STAFF_EMAIL=staff@example.com
STAFF_DISPLAY_NAME=Store Staff
STAFF_PASSWORD=replace_with_staff_password

# Frontend runtime configuration
API_BASE_URL=http://localhost:5000
APP_ENVIRONMENT=development
